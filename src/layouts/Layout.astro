---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "SHERD // FULL STACK ENGINEER & CREATIVE DEVELOPER",
	description = "Portafolio de desarrollo full stack y dirección de arte web inspirada en sistemas gráficos de vanguardia." 
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png?v=2" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Script de Inicialización Anti-FOUC para Modo Oscuro (#080808) / Claro (#ebe6e6) -->
		<script is:inline>
			(function() {
				const savedTheme = localStorage.getItem('theme');
				if (savedTheme) {
					document.documentElement.setAttribute('data-theme', savedTheme);
				} else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
					document.documentElement.setAttribute('data-theme', 'light');
				} else {
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			})();
		</script>
	</head>
	<body class="screen-texture">
		<a href="#main-content" class="skip-link">Saltar al contenido principal</a>
		<slot />
	</body>
</html>
