---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalURL?: string;
}

const {
	title = "LEINAD ODREIUQZI // SOFTWARE ANALYST & DEVELOPER — PORTFOLIO",
	description = "Portfolio of Leinad Odreiuqzi — Full Stack Software Analyst & Developer. Creator of LambdaIDX, AstroBrit, AlbumBeats, and Herbario.",
	image = "/astrobrit-poster.webp",
	canonicalURL = "https://leinadodreiuqzi.github.io/",
} = Astro.props;

const siteUrl = "https://leinadodreiuqzi.github.io";
const ogImageUrl = new URL(image, siteUrl).toString();

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Person",
			"@id": `${siteUrl}/#person`,
			name: "Leinad Odreiuqzi",
			alternateName: "Sherd",
			jobTitle: "Software Analyst & Developer",
			url: siteUrl,
			sameAs: [
				"https://github.com/LeinadOdreiuqzi",
				"https://astro-brit.vercel.app/"
			],
			knowsAbout: [
				"Astro",
				"TypeScript",
				"React",
				"Next.js",
				"PostgreSQL",
				"GSAP",
				"Web 3D & Creative Development",
				"Docker"
			]
		},
		{
			"@type": "WebSite",
			"@id": `${siteUrl}/#website`,
			url: siteUrl,
			name: "Leinad Odreiuqzi Portfolio",
			description: description,
			publisher: {
				"@id": `${siteUrl}/#person`
			}
		},
		{
			"@type": "SoftwareApplication",
			"@id": `${siteUrl}/#astrobrit`,
			name: "AstroBrit",
			applicationCategory: "CommunityPlatform",
			operatingSystem: "Web Browser",
			url: "https://astro-brit.vercel.app/",
			author: {
				"@id": `${siteUrl}/#person`
			},
			description: "High-performance community web platform for BritanniaMC Towny featuring an interactive 89-frame cinematic camera flythrough and Astro v7 islands architecture."
		},
		{
			"@type": "SoftwareApplication",
			"@id": `${siteUrl}/#lambdaidx`,
			name: "LambdaIDX",
			applicationCategory: "DeveloperApplication",
			operatingSystem: "Web Browser",
			author: {
				"@id": `${siteUrl}/#person`
			},
			description: "Enterprise-grade knowledge base and documentation platform built with Next.js App Router, PostgreSQL, and hierarchical navigation."
		}
	]
};
---

<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png?v=2" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="canonical" href={canonicalURL} />

		<!-- SEO & Search Engine Metadata -->
		<meta name="robots" content="index, follow" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="Leinad Odreiuqzi" />
		<meta name="theme-color" content="#080808" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#ebe6e6" media="(prefers-color-scheme: light)" />
		<title>{title}</title>

		<!-- OpenGraph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="960" />
		<meta property="og:image:height" content="495" />
		<meta property="og:image:alt" content="AstroBrit 3D Flythrough Showcase — Leinad Odreiuqzi Portfolio" />
		<meta property="og:site_name" content="Leinad Odreiuqzi Portfolio" />
		<meta property="og:locale" content="es_ES" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<!-- Google Fonts Preconnect & Stylesheet -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Chakra+Petch:wght@400;600;700&family=Inter:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>

		<!-- Script de Inicialización Anti-FOUC para Modo Oscuro (#080808) / Claro (#ebe6e6) -->
		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem("theme");
				if (savedTheme) {
					document.documentElement.setAttribute(
						"data-theme",
						savedTheme,
					);
				} else if (
					window.matchMedia("(prefers-color-scheme: light)").matches
				) {
					document.documentElement.setAttribute(
						"data-theme",
						"light",
					);
				} else {
					document.documentElement.setAttribute("data-theme", "dark");
				}
			})();
		</script>
	</head>
	<body class="screen-texture">
		<a href="#main-content" class="skip-link"
			>Saltar al contenido principal</a
		>
		<slot />
	</body>
</html>
