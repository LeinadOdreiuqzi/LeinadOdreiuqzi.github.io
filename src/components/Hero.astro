---

<section class="hero-section">
  <div class="container">
    <!-- Top Metadata Bar -->
    <div class="meta-row font-mono">
      <span class="text-magenta">[PORTAFOLIO DE INGENIERÍA]</span>
      <span class="text-muted">SYS_ID: SHERD_DEV_2026</span>
      <span class="text-muted hidden-mobile">LOCATION: REMOTE // GLOBAL</span>
    </div>

    <!-- Main Editorial Title -->
    <div class="hero-main">
      <h1 class="hero-name font-nucore">
        SHERD
      </h1>

      <div class="hero-subtitle font-nucore">
        <span class="text-magenta">FULL STACK</span> ENGINEER <br />
        <span class="text-white">& CREATIVE DEVELOPER</span>
      </div>

      <p class="hero-bio font-body">
        Especializado en la creación de aplicaciones web de alto rendimiento, sistemas de información escalables y experiencias digitales con dirección de arte gráfica de vanguardia.
      </p>

      <!-- Action Triggers -->
      <div class="hero-actions font-mono">
        <a href="#proyectos" class="btn-action">
          <span>[ VER PROYECTOS DESTACADOS ]</span>
          <span>→</span>
        </a>
        <a href="#contacto" class="btn-action btn-action-outline">
          <span>[ INICIAR CONTACTO ]</span>
        </a>
      </div>
    </div>

    <!-- Bottom Tech Summary Tags -->
    <div class="tech-bar font-mono">
      <div class="tech-item">
        <span class="text-magenta">01.</span> ASTRO & NEXT.JS
      </div>
      <div class="tech-item">
        <span class="text-magenta">02.</span> TYPESCRIPT STRICT
      </div>
      <div class="tech-item">
        <span class="text-magenta">03.</span> NODE & POSTGRESQL
      </div>
      <div class="tech-item">
        <span class="text-magenta">04.</span> HIGH PERF UI/UX
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 80px 0 100px;
    background-color: var(--bg-black);
    border-bottom: 1px solid var(--border-line);
    position: relative;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .meta-row {
    display: flex;
    gap: 24px;
    font-size: 0.85rem;
    margin-bottom: 32px;
  }

  .hero-main {
    max-width: 1100px;
    margin-bottom: 64px;
  }

  .hero-name {
    font-size: clamp(4.5rem, 12vw, 12rem);
    font-weight: 700;
    line-height: 0.85;
    color: var(--text-white);
    margin-bottom: 16px;
    letter-spacing: 0.02em;
  }

  .hero-subtitle {
    font-size: clamp(2.2rem, 5vw, 5rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 28px;
    letter-spacing: 0.03em;
  }

  .hero-bio {
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    color: var(--text-muted);
    max-width: 720px;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .tech-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    padding-top: 36px;
    border-top: 1px solid var(--border-line);
    font-size: 0.85rem;
  }

  .tech-item {
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hidden-mobile {
      display: none;
    }
  }
</style>
