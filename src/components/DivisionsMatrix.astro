---
const divisions = [
  {
    code: "01 / NUCORE",
    title: "NUCORE SYSTEMS",
    category: "COMPUTATIONAL HARDWARE",
    serial: "TRX-CORE-901",
    status: "VERIFIED",
    color: "var(--accent-orange)",
    desc: "Procesamiento de arquitectura brutalista de alta densidad. Matriz cuántica de control de datos y subrutinas sintéticas de respuesta inmediata."
  },
  {
    code: "02 / SYNTHESIS",
    title: "SYNTHETIC GENESIS",
    category: "BIO-TECHNICAL RESEARCH",
    serial: "BIO-GEN-404",
    status: "ACTIVE",
    color: "var(--accent-teal)",
    desc: "Ingeniería de polímeros orgánicos y genómica adaptativa. Diseño de exo-estructuras celulares para entornos de alta radiación."
  },
  {
    code: "03 / UESC",
    title: "UESC NAVAL COMMAND",
    category: "ORBITAL INTELLIGENCE",
    serial: "UESC-DIR-088",
    status: "RESTRICTED",
    color: "var(--accent-yellow)",
    desc: "Supervisión institucional y logística de espacio profundo. Mantenimiento de redes de transmisión y protocolos de respuesta táctica."
  },
  {
    code: "04 / TRAXUS",
    title: "TRAXUS HEAVY IND.",
    category: "INDUSTRIAL MACHINERY",
    serial: "TRX-HEAVY-002",
    status: "DEPLOYED",
    color: "var(--text-primary)",
    desc: "Construcción de maquinaria de extracción pesada y cápsulas atmosféricas de blindaje reforzado con alineación a grilla rígida."
  }
];
---

<section id="divisions" class="divisions-section">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header">
      <div class="header-left">
        <div class="section-tag font-tech">
          <span class="text-orange">// MATRIZ CORPORATIVA</span>
          <span>SYSTEM_SECTORS</span>
        </div>
        <h2 class="section-title font-display">
          DIVISIONES <span class="text-orange">CORPORATIVAS</span>
        </h2>
      </div>
      <div class="header-right font-tech text-dim hidden-mobile">
        DIV_COUNT: 04 // PROTOCOL_ID: 9940_DIV<br />
        SURFACE: DRY_MATTE // ZERO_GLOW
      </div>
    </div>

    <!-- Divisions Grid -->
    <div class="divisions-grid">
      {divisions.map((div) => (
        <div class="div-card chamfer-tr">
          <div class="card-top font-tech">
            <span class="div-code" style={`color: ${div.color}`}>{div.code}</span>
            <span class="div-status font-tech">{div.status}</span>
          </div>

          <div class="card-body">
            <span class="div-cat font-tech">{div.category}</span>
            <h3 class="div-title font-display">{div.title}</h3>
            <p class="div-desc">{div.desc}</p>
          </div>

          <div class="card-footer font-tech">
            <span class="text-dim">SERIAL: {div.serial}</span>
            <a href="#specs" class="card-link">
              <span>EXPLORAR</span>
              <span class="link-arrow">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .divisions-section {
    padding: 80px 0;
    background-color: var(--bg-surface);
    border-bottom: 2px solid var(--border-strong);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border-strong);
  }

  .section-tag {
    font-size: 0.8rem;
    display: flex;
    gap: 12px;
    margin-bottom: 8px;
  }

  .text-orange {
    color: var(--accent-orange);
  }

  .text-dim {
    color: var(--text-dim);
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .header-right {
    font-size: 0.75rem;
    text-align: right;
    line-height: 1.5;
  }

  /* Grid */
  .divisions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .div-card {
    background-color: var(--bg-primary);
    border: 2px solid var(--border-strong);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 280px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .div-card:hover {
    border-color: var(--accent-orange);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .div-code {
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .div-status {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    font-size: 0.7rem;
    color: var(--text-secondary);
  }

  .card-body {
    padding: 16px 0;
  }

  .div-cat {
    font-size: 0.7rem;
    color: var(--text-dim);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 6px;
  }

  .div-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .div-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    padding-top: 16px;
    border-top: 1px dashed var(--border-subtle);
  }

  .card-link {
    color: var(--text-primary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    transition: color 0.15s ease;
  }

  .div-card:hover .card-link {
    color: var(--accent-orange);
  }

  @media (max-width: 768px) {
    .hidden-mobile {
      display: none;
    }
  }
</style>
