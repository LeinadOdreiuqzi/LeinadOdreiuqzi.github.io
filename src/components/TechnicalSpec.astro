---
const specsData = [
  { label: "FUENTEMENTE TIPOGRÁFICA", value: "behance-6856b846f0def.otf", code: "OTF_01" },
  { label: "ACABADO DE SUPERFICIE", value: "MATTE / DRY / OPAQUE", code: "MAT_02" },
  { label: "FRANJAS DE SEGURIDAD", value: "45° HAZARD REPEATING LINEAR", code: "HZ_03" },
  { label: "SISTEMA BORDES", value: "CHAFLÁN 45° POLYGON (CLIP-PATH)", code: "CUT_04" },
  { label: "RADIO DE BORDES", value: "0PX STRICT BRUTALIST", code: "RAD_05" },
  { label: "PALETA PRIMARIA", value: "#0A0B0D / #F4F4F0 / #FF5500", code: "CLR_06" },
  { label: "RESPUESTA MECÁNICA", value: "120MS - 350MS TRANSITION", code: "MS_07" }
];
---

<section id="specs" class="specs-section">
  <div class="container">
    <div class="spec-board chamfer-bl-tr">
      <!-- Top Caution Banner -->
      <div class="banner-hazard hazard-stripes">
        <div class="banner-text font-tech">
          ⚠️ NUCALORIC HEAVY INDUSTRIES // TECHNICAL SPECIFICATION MATRIX // CLASSIFIED
        </div>
      </div>

      <div class="spec-layout">
        <!-- Left: Spec Matrix Header -->
        <div class="spec-intro">
          <div class="intro-tag font-tech">
            <span class="text-orange">[SPEC_DATA_SHEET]</span>
            <span class="text-dim">NC-SPEC-2026-X</span>
          </div>

          <h3 class="spec-title font-display">
            ESPECIFICACIONES <br />
            <span class="text-orange">TÉCNICAS DE DISEÑO</span>
          </h3>

          <p class="spec-p font-body">
            Matriz de parámetros extraídos directamente de las guías gráficas corporativas de Marathon. Cada propiedad técnica responde a un propósito utilitario dentro de la plataforma.
          </p>

          <!-- Interactive Action Badge -->
          <div class="barcode-container font-tech">
            <div class="barcode-graphic">
              ||| | ||||| || |||||| | ||| ||||||| | |||
            </div>
            <div class="barcode-info">
              <span>BATCH: NC-9940-2026</span>
              <span class="text-orange">VERIFIED // DRY</span>
            </div>
          </div>
        </div>

        <!-- Right: Technical Specification Table -->
        <div class="spec-table font-tech">
          <div class="table-head">
            <span>CÓDIGO</span>
            <span>PROPIEDAD TÉCNICA</span>
            <span>VALOR / PARÁMETRO</span>
          </div>

          <div class="table-body">
            {specsData.map((spec) => (
              <div class="table-row">
                <span class="col-code text-orange">{spec.code}</span>
                <span class="col-label">{spec.label}</span>
                <span class="col-val text-dim">{spec.value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Bottom Status Bar -->
      <div class="spec-footer font-tech">
        <div class="footer-left">
          <span>SEC_LEVEL: ALPHA</span>
          <span class="divider">|</span>
          <span>SYSTEM_OPERATIONAL: TRUE</span>
        </div>
        <div class="footer-right">
          <span class="text-orange">NUCALORIC CORPORATE ARCHIVE // 2026</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .specs-section {
    padding: 80px 0;
    background-color: var(--bg-primary);
    border-bottom: 2px solid var(--border-strong);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .spec-board {
    background-color: var(--bg-surface);
    border: 2px solid var(--border-strong);
    padding: 0;
    overflow: hidden;
  }

  .banner-hazard {
    padding: 8px 16px;
    border-bottom: 2px solid var(--border-strong);
  }

  .banner-text {
    background-color: var(--bg-primary);
    color: var(--accent-yellow);
    display: inline-block;
    padding: 4px 12px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .spec-layout {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 40px;
    padding: 40px;
  }

  .intro-tag {
    font-size: 0.8rem;
    display: flex;
    gap: 12px;
    margin-bottom: 12px;
  }

  .text-orange {
    color: var(--accent-orange);
  }

  .text-dim {
    color: var(--text-dim);
  }

  .spec-title {
    font-size: clamp(1.8rem, 2.8vw, 2.5rem);
    font-weight: 700;
    line-height: 1.05;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .spec-p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .barcode-container {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-strong);
    padding: 16px;
  }

  .barcode-graphic {
    font-size: 1.2rem;
    letter-spacing: 3px;
    color: var(--text-primary);
    margin-bottom: 8px;
    text-align: center;
  }

  .barcode-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
  }

  /* Spec Table */
  .spec-table {
    border: 1px solid var(--border-strong);
    background-color: var(--bg-primary);
  }

  .table-head {
    display: grid;
    grid-template-columns: 90px 220px 1fr;
    padding: 12px 16px;
    background-color: var(--bg-surface-elevated);
    border-bottom: 1px solid var(--border-strong);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
  }

  .table-body {
    display: flex;
    flex-direction: column;
  }

  .table-row {
    display: grid;
    grid-template-columns: 90px 220px 1fr;
    padding: 14px 16px;
    border-bottom: 1px dashed var(--border-subtle);
    font-size: 0.85rem;
    align-items: center;
    transition: background-color 0.15s ease;
  }

  .table-row:hover {
    background-color: var(--bg-surface);
  }

  .col-code {
    font-weight: 700;
  }

  .col-label {
    color: var(--text-primary);
    font-weight: 600;
  }

  .col-val {
    font-size: 0.8rem;
  }

  .spec-footer {
    display: flex;
    justify-content: space-between;
    padding: 12px 24px;
    background-color: var(--bg-surface-elevated);
    border-top: 2px solid var(--border-strong);
    font-size: 0.75rem;
  }

  .footer-left {
    display: flex;
    gap: 12px;
    color: var(--text-secondary);
  }

  .divider {
    color: var(--border-strong);
  }

  @media (max-width: 992px) {
    .spec-layout {
      grid-template-columns: 1fr;
    }

    .table-head, .table-row {
      grid-template-columns: 70px 160px 1fr;
    }
  }
</style>
