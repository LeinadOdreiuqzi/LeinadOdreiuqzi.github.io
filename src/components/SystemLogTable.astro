---
const logs = [
  { id: "LOG_99401", time: "12:54:02.109", sector: "SECTOR_07", event: "SYSTEM_INITIALIZATION_SUCCESS", status: "OK", level: "INFO" },
  { id: "LOG_99402", time: "12:54:02.450", sector: "NUCORE_SYS", event: "OTF_FONT_LOADED [behance-6856b8]", status: "VERIFIED", level: "SUCCESS" },
  { id: "LOG_99403", time: "12:54:03.011", sector: "SYNTHESIS", event: "DRY_MATTE_SURFACE_CHECK", status: "PASSED", level: "SUCCESS" },
  { id: "LOG_99404", time: "12:54:04.890", sector: "UESC_COMMAND", event: "SECURITY_PROTOCOL_ALPHA_DEPLOYED", status: "ACTIVE", level: "WARN" },
  { id: "LOG_99405", time: "12:54:05.120", sector: "TRAXUS_HEAVY", event: "ZERO_GLOW_CONSTRAINT_ENFORCED", status: "STRICT", level: "INFO" }
];
---

<section id="logs" class="logs-section font-tech">
  <div class="container">
    <div class="logs-header">
      <div class="header-tag">
        <span class="text-orange">// REGISTRO DE EVENTOS</span>
        <span class="text-dim">SYSTEM_LOG_MATRIX</span>
      </div>
      <h2 class="logs-title font-display">
        REGISTRO DE <span class="text-orange">ACTIVIDAD DEL SISTEMA</span>
      </h2>
    </div>

    <div class="log-table-container chamfer-tr">
      <table class="log-table">
        <thead>
          <tr>
            <th>ID LOG</th>
            <th>TIMESTAMP</th>
            <th>SECTOR</th>
            <th>EVENTO / ACTIVIDAD</th>
            <th>NIVEL</th>
            <th>ESTADO</th>
          </tr>
        </thead>
        <tbody>
          {logs.map((log) => (
            <tr>
              <td class="text-orange font-bold">{log.id}</td>
              <td class="text-dim">{log.time}</td>
              <td>{log.sector}</td>
              <td class="text-primary">{log.event}</td>
              <td><span class="badge-level">{log.level}</span></td>
              <td><span class="badge-status text-orange">{log.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .logs-section {
    padding: 80px 0;
    background-color: var(--bg-surface);
    border-bottom: 2px solid var(--border-strong);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .logs-header {
    margin-bottom: 32px;
  }

  .header-tag {
    font-size: 0.8rem;
    display: flex;
    gap: 12px;
    margin-bottom: 8px;
  }

  .text-orange {
    color: var(--accent-orange);
  }

  .text-dim {
    color: var(--text-dim);
  }

  .text-primary {
    color: var(--text-primary);
  }

  .font-bold {
    font-weight: 700;
  }

  .logs-title {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 700;
    text-transform: uppercase;
  }

  .log-table-container {
    background-color: var(--bg-primary);
    border: 2px solid var(--border-strong);
    overflow-x: auto;
  }

  .log-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    text-align: left;
  }

  .log-table th {
    background-color: var(--bg-surface-elevated);
    color: var(--text-secondary);
    padding: 14px 18px;
    border-bottom: 2px solid var(--border-strong);
    font-size: 0.75rem;
  }

  .log-table td {
    padding: 14px 18px;
    border-bottom: 1px dashed var(--border-subtle);
  }

  .log-table tr:hover {
    background-color: var(--bg-surface);
  }

  .badge-level {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    padding: 2px 6px;
    font-size: 0.7rem;
    color: var(--text-secondary);
  }

  .badge-status {
    border: 1px solid var(--accent-orange);
    padding: 2px 6px;
    font-size: 0.7rem;
  }
</style>
