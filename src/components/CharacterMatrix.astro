---
const techStack = [
  {
    name: "NEXT.JS",
    category: "FRONTEND",
    iconUrl: "https://cdn.simpleicons.org/nextdotjs/000000",
  },
  {
    name: "ASTRO.JS",
    category: "FRONTEND",
    iconUrl: "https://cdn.simpleicons.org/astro/000000",
  },
  {
    name: "TYPESCRIPT",
    category: "LANGUAGE",
    iconUrl: "https://cdn.simpleicons.org/typescript/000000",
  },
  {
    name: "JAVASCRIPT",
    category: "LANGUAGE",
    iconUrl: "https://cdn.simpleicons.org/javascript/000000",
  },
  {
    name: "PYTHON",
    category: "LANGUAGE",
    iconUrl: "https://cdn.simpleicons.org/python/000000",
  },
  {
    name: "REACT",
    category: "LIBRARY",
    iconUrl: "https://cdn.simpleicons.org/react/000000",
  },
  {
    name: "LUA",
    category: "LANGUAGE",
    iconUrl: "https://cdn.simpleicons.org/lua/000000",
  },
  {
    name: "TAILWIND",
    category: "STYLING",
    iconUrl: "https://cdn.simpleicons.org/tailwindcss/000000",
  },
  {
    name: "POSTGRESQL",
    category: "DATABASE",
    iconUrl: "https://cdn.simpleicons.org/postgresql/000000",
  },
  {
    name: "PRISMA",
    category: "ORM",
    iconUrl: "https://cdn.simpleicons.org/prisma/000000",
  },
  {
    name: "GIT / GITHUB",
    category: "TOOL",
    iconUrl: "https://cdn.simpleicons.org/github/000000",
  },
  {
    name: "VERCEL",
    category: "INFRA",
    iconUrl: "https://cdn.simpleicons.org/vercel/000000",
  },
];
---

<section id="stack" class="matrix-section font-mono">
  <!-- Row 1: Tech Stack Overview (Black Left, Magenta Right) -->
  <div class="matrix-row">
    <!-- Left Specs -->
    <div class="grid-tile theme-black">
      <div class="matrix-specs">
        <div class="section-tag text-magenta font-bold">
          SYSTEM // 04 — TECH STACK & TOOLS
        </div>
        <h2 class="section-title font-nucore text-white">TECHNOLOGY MATRIX</h2>

        <div class="spec-item">
          <span class="text-muted">PRIMARY FRONTEND</span>
          <span class="text-magenta font-bold">NEXT.JS / ASTRO.JS</span>
        </div>
        <div class="spec-item">
          <span class="text-muted">CORE LANGUAGES</span>
          <span>TYPESCRIPT, JAVASCRIPT, PYTHON</span>
        </div>
        <div class="spec-item">
          <span class="text-muted">TOOLS & INFRASTRUCTURE</span>
          <span class="text-magenta">GIT, VERCEL, FIGMA</span>
        </div>
        <div class="spec-item">
          <span class="text-muted">DATABASE & ORM</span>
          <span>POSTGRESQL + PRISMA</span>
        </div>
      </div>

      <div class="section-tag-bottom">
        <span>CORE COMPETENCIES</span>
      </div>
    </div>

    <!-- Right Tech Stack Grid -->
    <div class="grid-tile theme-magenta">
      <div class="tech-grid font-nucore">
        {
          techStack.map((tech) => (
            <div class="tech-cell">
              <div class="tech-watermark">
                <img
                  src={tech.iconUrl}
                  alt=""
                  aria-hidden="true"
                  class="tech-icon-img"
                  loading="lazy"
                  decoding="async"
                  width="24"
                  height="24"
                />
              </div>
              <span class="tech-name">{tech.name}</span>
              <span class="tech-cat font-mono">{tech.category}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Row 2: SENA Education & ADSO Degree (Magenta Left, Black Right) -->
  <div id="experience" class="matrix-row">
    <!-- Left Education Tile with SENA Logo -->
    <div class="grid-tile theme-magenta">
      <div class="sena-education-content">
        <div class="edu-tag text-black font-bold">EDUCATION & CREDENTIALS</div>

        <div class="credentials-list">
          <!-- SENA Credential Card -->
          <div class="sena-badge-card">
            <div class="sena-logo-wrapper">
              <img
                src="/sena-logo.png"
                alt="SENA Logo"
                class="sena-badge-img"
                width="100"
                height="98"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="sena-badge-text font-mono text-black">
              <div class="badge-title font-bold">SENA COLOMBIA</div>
              <div class="badge-sub font-bold">
                TECHNOLOGIST IN SOFTWARE ANALYSIS & DEVELOPMENT (ADSO)
              </div>
              <div class="badge-course font-bold">
                // PYTHON DATA VISUALIZATION
              </div>
            </div>
          </div>

          <!-- Cisco Python Credly Verified Badge -->
          <div class="credly-badge-card">
            <a
              href="https://www.credly.com/badges/9968e0b6-606f-4bf4-8508-4668eb122081/linked_in_profile"
              target="_blank"
              rel="noopener noreferrer"
              class="credly-logo-link"
              title="Cisco Networking Academy — Python Essentials 1 (Credly Verified)"
            >
              <img
                src="/cisco-python-badge.png"
                alt="Cisco Networking Academy - Python Essentials 1 Verified Badge"
                class="credly-badge-img"
                width="600"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </a>

            <div class="credly-badge-text font-mono text-black">
              <div class="badge-title font-bold">CISCO NETWORKING ACADEMY</div>
              <div class="badge-sub font-bold">PYTHON ESSENTIALS 1</div>
            </div>
          </div>
        </div>
      </div>

      <div class="section-tag-dark">
        <span>OFFICIAL ACADEMIC CREDENTIAL</span>
      </div>
    </div>

    <!-- Right Capstone & Career Specs -->
    <div class="grid-tile theme-black">
      <div class="matrix-specs">
        <div class="section-tag text-magenta font-bold">
          CAPSTONE & EXPERIENCE HIGHLIGHT
        </div>

        <h3 class="capstone-title font-nucore text-white">
          2.5 YEARS EXPERIENCE
        </h3>

        <p class="capstone-desc text-muted font-body">
          2.5 years of software engineering experience, including 6 dedicated
          months developing the main LambdaIDX capstone platform to complete
          SENA graduation requirements as Software Developer.
        </p>

        <div class="spec-item">
          <span class="text-muted">TOTAL EXPERIENCE</span>
          <span class="text-white font-bold"
            >2.5 YEARS (INCL. 6-MO CAPSTONE)</span
          >
        </div>
        <div class="spec-item">
          <span class="text-muted">INSTITUTION</span>
          <span class="text-white font-bold">SENA COLOMBIA</span>
        </div>
        <div class="spec-item">
          <span class="text-muted">ACADEMIC STATUS</span>
          <span class="text-magenta">GRADUATED & VERIFIED</span>
        </div>
        <div class="spec-item">
          <span class="text-muted">WORK AVAILABILITY</span>
          <span class="text-magenta">ON-SITE & REMOTE</span>
        </div>
      </div>

      <div class="section-tag-bottom">
        <span>EXPERIENCE RECORD</span>
      </div>
    </div>
  </div>
</section>

<style>
  .matrix-section {
    display: flex;
    flex-direction: column;
    border-bottom: none;
  }

  .matrix-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 500px;
    border-bottom: none;
  }

  .grid-tile {
    padding: 48px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .theme-black {
    background-color: var(--bg-black);
    color: var(--text-white);
  }

  .theme-magenta {
    background-color: var(--bg-magenta);
    color: var(--text-black);
  }

  .matrix-specs {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 440px;
    font-size: 0.85rem;
  }

  .section-tag {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 8px;
  }

  .spec-item {
    display: flex;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--border-line);
  }

  .text-magenta {
    color: var(--text-magenta);
  }
  .text-white {
    color: var(--text-white);
  }
  .text-black {
    color: var(--text-black);
  }
  .text-muted {
    color: var(--text-muted);
  }
  .font-bold {
    font-weight: 700;
  }

  .section-tag-bottom {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: auto;
    padding-top: 24px;
    letter-spacing: 0.1em;
    text-align: right;
  }

  .section-tag-dark {
    font-size: 0.75rem;
    color: var(--text-black);
    margin-top: auto;
    padding-top: 24px;
    letter-spacing: 0.1em;
    text-align: right;
    font-weight: 700;
  }

  /* Tech Grid */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    align-content: center;
    height: 100%;
  }

  .tech-cell {
    position: relative;
    overflow: hidden;
    background-color: rgba(8, 8, 8, 0.12);
    padding: 24px 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    border: none;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .tech-cell:hover {
    background-color: rgba(8, 8, 8, 0.22);
  }

  .tech-watermark {
    position: absolute;
    right: -10px;
    bottom: -10px;
    width: 68px;
    height: 68px;
    opacity: 0.12;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tech-icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: brightness(0);
  }

  .tech-cell:hover .tech-watermark {
    opacity: 0.28;
    transform: scale(1.15) rotate(-5deg);
  }

  .tech-name {
    position: relative;
    z-index: 2;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-black);
    line-height: 1.2;
  }

  .tech-cat {
    position: relative;
    z-index: 2;
    font-size: 0.65rem;
    color: rgba(8, 8, 8, 0.7);
    letter-spacing: 0.05em;
    font-weight: 700;
  }

  /* Education & Credentials Section */
  .sena-education-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 480px;
  }

  .edu-tag {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .credentials-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 4px;
  }

  .sena-badge-card,
  .credly-badge-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background-color: transparent;
    border: none;
    padding: 0;
  }

  .sena-logo-wrapper,
  .credly-logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    flex-shrink: 0;
  }

  .sena-badge-img {
    width: 54px;
    height: 54px;
    object-fit: contain;
    filter: brightness(0);
  }

  .credly-badge-img {
    width: 54px;
    height: 54px;
    object-fit: contain;
    display: block;
  }

  .credly-logo-link {
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .credly-logo-link:hover {
    transform: scale(1.05);
    opacity: 0.9;
  }

  .sena-badge-text,
  .credly-badge-text {
    font-size: 0.72rem;
    line-height: 1.35;
    display: flex;
    flex-direction: column;
  }

  .badge-title {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }

  .badge-sub {
    font-size: 0.75rem;
    opacity: 0.95;
  }

  .badge-course {
    font-size: 0.7rem;
    opacity: 0.85;
    margin-top: 2px;
    letter-spacing: 0.02em;
  }

  .capstone-title {
    font-size: clamp(1.8rem, 3vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 4px;
  }

  .capstone-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 12px;
  }

  @media (max-width: 992px) {
    .matrix-row {
      grid-template-columns: 1fr;
    }

    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
