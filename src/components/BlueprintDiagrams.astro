    letter-spacing: 0.1em;
  }

  .project-title {
    font-size: clamp(2.2rem, 3.8vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    margin-top: 4px;
  }

  .project-subtitle {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  .project-desc {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .text-magenta { color: var(--text-magenta); }
