    opacity: 1;
  }

  .section-tag-dark {
    font-size: 0.75rem;
    color: var(--text-black);
    text-align: right;
    margin-top: auto;
    padding-top: 24px;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  /* Right Tile: Black */
