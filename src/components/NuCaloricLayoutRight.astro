---
import SidebarBarcode from "./SidebarBarcode.astro";

interface Props {
  title?: string;
  numeral?: string;
  serial?: string;
}

const {
  title = "AstroBrit Platform",
  numeral = "02",
  serial = "NC-SPECIMEN // ASTROBRIT COMMUNITY WEB",
} = Astro.props;
---

<section class="nucaloric-layout-right font-mono">
  <!-- Main Left Specimen Area -->
  <div class="specimen-main">
    <!-- Brand Title -->
    <header class="specimen-header">
      <h1 class="brand-title font-body">{title}</h1>
    </header>

    <!-- Giant Numerals Background (187) -->
    <div class="giant-numeral font-nucore" aria-hidden="true">
      {numeral}
    </div>

    <!-- Center Content Slot -->
    <div class="center-content-area">
      <div class="content-box">
        <slot>
          <!-- Specimen 02: AstroBrit & Open Source Archive -->
          <div class="specimen-badge">
            <span class="badge-tag">[SPECIMEN 02]</span>
            <span class="badge-title font-nucore">ASTROBRIT // BRITANNIAMC</span
            >
          </div>

          <div class="specimen-grid font-mono">
            <div class="spec-col">
              <span class="label">COMMUNITY PLATFORM</span>
              <a
                href="https://astro-brit.vercel.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="value text-magenta spec-link"
              >
                ASTROBRIT ↗
              </a>
            </div>
            <div class="spec-col">
              <span class="label">ARCHIVE // BEATS</span>
              <a
                href="https://github.com/LeinadOdreiuqzi/AlbumBeats"
                target="_blank"
                rel="noopener noreferrer"
                class="value text-magenta spec-link"
              >
                ALBUMBEATS ↗
              </a>
            </div>
            <div class="spec-col">
              <span class="label">ARCHIVE // BOTANICAL</span>
              <a
                href="https://github.com/LeinadOdreiuqzi/Herbario"
                target="_blank"
                rel="noopener noreferrer"
                class="value text-magenta spec-link"
              >
                HERBARIO ↗
              </a>
            </div>
          </div>

          <!-- Dynamic AstroBrit UI Preview Container (Hover to Play GIF / Click to Visit) -->
          <div class="lambdaidx-preview-container">
            <div class="preview-header font-mono">
              <span class="text-magenta font-bold">// ASTROBRIT</span>
              <span class="text-muted">BRITANNIAMC TOWNY WEB</span>
            </div>

            <div class="preview-frame" id="astrobrit-preview-frame">
              <a
                href="https://astro-brit.vercel.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="preview-link"
                aria-label="AstroBrit BritanniaMC — Abrir en vivo en una nueva pestaña"
              >
                <div class="preview-media-stack">
                  <img
                    id="astrobrit-preview-img"
                    src="/astrobrit-poster.webp"
                    alt="AstroBrit BritanniaMC 3D Flythrough Showcase"
                    class="preview-img"
                    width="960"
                    height="495"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </a>
            </div>
          </div>
        </slot>
      </div>
    </div>

    <!-- Bottom Serial Code -->
    <footer class="specimen-footer">
      <span class="serial-code">{serial}</span>
    </footer>
  </div>

  <!-- Right Magenta Vertical Bar (Extrema Derecha) -->
  <aside class="magenta-sidebar">
    <div class="sidebar-top">
      <div class="logo-mark font-nucore">N02</div>
      <SidebarBarcode />
    </div>

    <div class="sidebar-bottom">
      <span class="vertical-text text-sponsored">
        <svg
          class="pixel-arrow arrow-right"
          width="14"
          height="18"
          viewBox="0 0 16 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <rect x="7" y="0" width="2" height="18"></rect>
          <rect x="7" y="18" width="2" height="2"></rect>
          <rect x="5" y="16" width="2" height="2"></rect>
          <rect x="9" y="16" width="2" height="2"></rect>
          <rect x="3" y="14" width="2" height="2"></rect>
          <rect x="11" y="14" width="2" height="2"></rect>
          <rect x="1" y="12" width="2" height="2"></rect>
          <rect x="13" y="12" width="2" height="2"></rect>
        </svg>
        Sponsored message
        <svg
          class="pixel-arrow arrow-right"
          width="14"
          height="18"
          viewBox="0 0 16 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <rect x="7" y="0" width="2" height="18"></rect>
          <rect x="7" y="18" width="2" height="2"></rect>
          <rect x="5" y="16" width="2" height="2"></rect>
          <rect x="9" y="16" width="2" height="2"></rect>
          <rect x="3" y="14" width="2" height="2"></rect>
          <rect x="11" y="14" width="2" height="2"></rect>
          <rect x="1" y="12" width="2" height="2"></rect>
          <rect x="13" y="12" width="2" height="2"></rect>
        </svg>
      </span>
    </div>
  </aside>
</section>

<style>
  .nucaloric-layout-right {
    display: grid;
    grid-template-columns: 1fr 72px;
    min-height: 540px;
    background-color: var(--bg-black);
    border: none;
    position: relative;
    overflow: hidden;
    margin: 0;
  }

  /* Right Magenta Sidebar (Extrema Derecha) */
  .magenta-sidebar {
    background-color: var(--bg-magenta);
    color: #080808;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 32px 0;
    user-select: none;
    border-left: none;
  }

  .sidebar-top,
  .sidebar-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .sidebar-bottom {
    margin-top: 24px;
  }

  .logo-mark {
    font-size: 1.1rem;
    font-weight: 700;
    background-color: #080808;
    color: var(--bg-magenta);
    padding: 6px 8px;
    line-height: 1;
  }

  .vertical-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .text-brand {
    color: #080808;
    margin-top: 12px;
  }

  .text-sponsored {
    color: #080808;
    opacity: 0.9;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  /* CSS Rotation Utility Classes */
  .pixel-arrow {
    display: inline-block;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .pixel-arrow.arrow-down {
    transform: rotate(0deg);
  }
  .pixel-arrow.arrow-up {
    transform: rotate(180deg);
  }
  .pixel-arrow.arrow-left {
    transform: rotate(90deg);
  }
  .pixel-arrow.arrow-right {
    transform: rotate(-90deg);
  }

  /* Main Specimen Panel (Left Side) */
  .specimen-main {
    padding: 48px 60px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    background-color: var(--bg-black);
    color: var(--text-white);
  }

  .specimen-header {
    z-index: 2;
    position: relative;
    display: flex;
    justify-content: flex-start;
  }

  .brand-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-white);
    line-height: 1;
    margin-bottom: 0;
    text-align: left;
  }

  /* Giant Magenta 187 Numeral (Positioned on the Left) */
  .giant-numeral {
    position: absolute;
    top: 40px;
    left: 60px;
    right: auto;
    font-size: clamp(8rem, 18vw, 16rem);
    font-weight: 700;
    color: var(--text-magenta);
    line-height: 0.8;
    user-select: none;
    z-index: 1;
    pointer-events: none;
    letter-spacing: -0.05em;
    opacity: 0.85;
  }

  /* Center Content Area (Aligned to the Left) */
  .center-content-area {
    z-index: 2;
    position: relative;
    margin-top: 40px;
    margin-bottom: 30px;
    max-width: 720px;
    width: 100%;
    margin-right: auto;
    margin-left: 0;
  }

  .content-box {
    background-color: var(--bg-dark-panel);
    border: none;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .specimen-badge {
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: none;
    padding-bottom: 16px;
  }

  .badge-tag {
    color: var(--text-magenta);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .badge-title {
    font-size: 1.4rem;
    font-weight: 700;
  }

  .specimen-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    font-size: 0.85rem;
  }

  .spec-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .label {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .value {
    font-weight: 700;
  }

  .spec-link {
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .spec-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* Dynamic AstroBrit Preview Frame (Hover-to-Play GIF) */
  .lambdaidx-preview-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 12px;
    border-top: 1px dashed var(--border-line);
    padding-top: 16px;
  }

  .preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    gap: 12px;
    flex-wrap: wrap;
  }

  .preview-frame {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border-line);
    background-color: var(--bg-black);
    position: relative;
    transition: border-color 0.2s ease;
  }

  .preview-frame:hover,
  .preview-frame:focus-within {
    border-color: var(--color-magenta);
  }

  .preview-link {
    display: block;
    width: 100%;
    text-decoration: none;
    outline: none;
    cursor: pointer;
  }

  .preview-link:focus-visible {
    outline: 2px dashed var(--color-magenta);
    outline-offset: 2px;
  }

  .preview-media-stack {
    position: relative;
    width: 100%;
    aspect-ratio: 960 / 495;
    background-color: #080808;
    overflow: hidden;
  }

  .preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 0.2s ease;
  }

  /* Footer Monospace Serial (Left Aligned) */
  .specimen-footer {
    z-index: 2;
    position: relative;
    padding-top: 16px;
    display: flex;
    justify-content: flex-start;
  }

  .serial-code {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    font-weight: 700;
    word-break: break-word;
  }

  @media (max-width: 900px) {
    .nucaloric-layout-right {
      grid-template-columns: 1fr 56px;
    }

    .specimen-main {
      padding: 32px 24px;
    }

    .giant-numeral {
      font-size: clamp(6rem, 18vw, 10rem);
      top: 40px;
      left: 24px;
      right: auto;
    }

    .center-content-area {
      margin-top: 40px;
    }

    .specimen-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .nucaloric-layout-right {
      display: flex;
      flex-direction: column;
    }

    .magenta-sidebar {
      order: -1;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      width: 100%;
    }

    .sidebar-top {
      flex-direction: row;
      gap: 12px;
      align-items: center;
    }

    .sidebar-top :global(.sidebar-barcode) {
      display: none;
    }

    .sidebar-bottom {
      margin-top: 0;
    }

    .vertical-text {
      writing-mode: horizontal-tb;
      transform: none;
      font-size: 0.7rem;
    }

    .specimen-main {
      padding: 24px 16px;
    }

    .brand-title {
      font-size: clamp(2rem, 8vw, 3rem);
    }

    .giant-numeral {
      font-size: clamp(5rem, 22vw, 8rem);
      top: 10px;
      left: 16px;
      opacity: 0.35;
    }

    .center-content-area {
      margin-top: 24px;
      margin-bottom: 20px;
    }

    .content-box {
      padding: 20px 14px;
      gap: 16px;
    }

    .specimen-badge {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .badge-title {
      font-size: 1.15rem;
    }

    .serial-code {
      font-size: 0.72rem;
      letter-spacing: 0.08em;
    }
  }
</style>

<script>
  const frame = document.getElementById("astrobrit-preview-frame");
  const img = document.getElementById(
    "astrobrit-preview-img",
  ) as HTMLImageElement | null;
  const staticSrc = "/astrobrit-poster.webp";
  const animSrc = "/astrobrit-preview.webp";

  if (frame && img) {
    const preload = new Image();
    preload.src = animSrc;

    frame.addEventListener("mouseenter", () => {
      img.src = animSrc;
    });

    frame.addEventListener("mouseleave", () => {
      img.src = staticSrc;
    });

    frame.addEventListener("focusin", () => {
      img.src = animSrc;
    });

    frame.addEventListener("focusout", () => {
      img.src = staticSrc;
    });
  }
</script>
