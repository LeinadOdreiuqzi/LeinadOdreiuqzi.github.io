<section id="contact" class="contact-grid font-mono">
  <!-- Left Tile: Direct Contact Methods (Black Theme) -->
  <div class="grid-tile theme-black">
    <div class="contact-details">
      <div class="section-tag text-magenta font-bold">
        COMMUNICATION CHANNELS
      </div>

      <h2 class="contact-title font-nucore text-white">
        CONTACT & NETWORK
      </h2>

      <p class="contact-sub text-muted font-body">
        Available for full-time software engineering roles, full stack contracts, and technical collaboration — on-site or remote.
      </p>

      <div class="contact-methods">
        <a href="mailto:sherdanialex159357@gmail.com" class="contact-row" aria-label="Enviar correo directo a sherdanialex159357@gmail.com">
          <span class="row-label text-muted">DIRECT EMAIL</span>
          <span class="row-value text-magenta font-bold">SHERDANIALEX159357@GMAIL.COM</span>
        </a>

        <a href="https://github.com/LeinadOdreiuqzi" target="_blank" rel="noopener noreferrer" class="contact-row" aria-label="Perfil de GitHub de Leinad Odreiuqzi (se abre en ventana nueva)">
          <span class="row-label text-muted">GITHUB PROFILE</span>
          <span class="row-value text-white font-bold">GITHUB.COM/LEINADODREIUQZI</span>
        </a>

        <div class="contact-row">
          <span class="row-label text-muted">WORK AVAILABILITY</span>
          <span class="row-value text-magenta font-bold">ON-SITE & REMOTE AVAILABLE</span>
        </div>

        <div class="contact-row">
          <span class="row-label text-muted">PROFESSIONAL TITLE</span>
          <span class="row-value text-white font-bold">SOFTWARE ANALYST & DEVELOPER</span>
        </div>
      </div>
    </div>

    <div class="section-tag-bottom">
      <span>DIRECT CHANNELS</span>
    </div>
  </div>

  <!-- Right Tile: Big Magenta CTA Banner (Magenta Theme) -->
  <div class="grid-tile theme-magenta">
    <div class="cta-inner">
      <div class="cta-tag text-black font-bold">
        INITIATE COLLABORATION
      </div>

      <h2 class="cta-headline font-nucore text-black">
        READY TO BUILD NEXT-GEN SOFTWARE?
      </h2>

      <p class="cta-desc text-black font-mono">
        LET'S CONNECT AND DEVELOP HIGH-PERFORMANCE SOLUTIONS.
      </p>

      <div class="cta-action">
        <a href="mailto:sherdanialex159357@gmail.com" class="btn-email-cta font-mono">
          <span>[ SEND EMAIL DIRECTLY ]</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <div class="section-tag-dark">
      <span>LEINAD ODREIUQZI // 2026</span>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 520px;
    border-bottom: 1px solid var(--border-line);
  }

  .grid-tile {
    padding: 48px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .theme-black {
    background-color: var(--bg-black);
    color: var(--text-white);
  }

  .theme-magenta {
    background-color: var(--bg-magenta);
    color: var(--text-black);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 480px;
  }

  .section-tag {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .contact-title {
    font-size: clamp(2.2rem, 3.8vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    margin-top: 4px;
  }

  .contact-sub {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 8px;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--border-line);
    text-decoration: none;
    font-size: 0.85rem;
    transition: opacity 0.15s ease;
  }

  .contact-row:hover {
    opacity: 0.85;
  }

  .row-label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .row-value {
    font-size: 0.95rem;
    letter-spacing: 0.03em;
  }

  .text-magenta { color: var(--text-magenta) !important; }
  .text-white { color: var(--text-white) !important; }
  .text-black { color: var(--text-black) !important; }
  .text-muted { color: var(--text-muted) !important; }
  .font-bold { font-weight: 700; }

  .section-tag-bottom {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: auto;
    padding-top: 24px;
    letter-spacing: 0.1em;
    text-align: right;
  }

  .section-tag-dark {
    font-size: 0.75rem;
    color: var(--text-black);
    margin-top: auto;
    padding-top: 24px;
    letter-spacing: 0.1em;
    text-align: right;
    font-weight: 700;
  }

  /* Right Magenta CTA */
  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 480px;
  }

  .cta-tag {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .cta-headline {
    font-size: clamp(2.2rem, 3.8vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    margin-top: 4px;
  }

  .cta-desc {
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    font-weight: 700;
  }

  .cta-action {
    margin-top: 16px;
  }

  .btn-email-cta, .btn-email-cta:visited {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background-color: var(--bg-black) !important;
    color: var(--text-white) !important;
    padding: 16px 24px;
    text-decoration: none !important;
    font-size: 0.9rem;
    font-weight: 700;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .btn-email-cta:hover {
    background-color: #1a1a1a !important;
    color: var(--text-magenta) !important;
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
