<section id="contact" class="contact-grid font-mono">
  <!-- Left Tile: Direct Contact Methods (Black Theme) -->
  <div class="grid-tile theme-black">
    <div class="contact-details">
      <div class="section-tag text-magenta font-bold">
        COMMUNICATION CHANNELS
      </div>

      <h2 class="contact-title font-nucore text-white">
        CONTACT & NETWORK
      </h2>

      <p class="contact-sub text-muted font-body">
        Available for full-time software engineering roles, full stack contracts, and technical collaboration — on-site or remote.
      </p>

      <div class="contact-methods">
        <button
          type="button"
          id="copy-email-btn"
          class="contact-row copy-trigger font-mono"
          aria-label="Copiar correo sherdanialex159357@gmail.com al portapapeles"
        >
          <div class="row-top">
            <span class="row-label text-muted">DIRECT EMAIL</span>
            <span class="copy-badge" id="copy-badge">[ CLICK TO COPY ]</span>
          </div>
          <span class="row-value text-magenta font-bold" id="email-text">
            SHERDANIALEX159357@GMAIL.COM
          </span>
          <span id="copy-live-alert" class="sr-only" aria-live="polite"></span>
        </button>

        <a href="https://github.com/LeinadOdreiuqzi" target="_blank" rel="noopener noreferrer" class="contact-row" aria-label="Perfil de GitHub de Leinad Odreiuqzi (se abre en ventana nueva)">
          <span class="row-label text-muted">GITHUB PROFILE</span>
          <span class="row-value text-white font-bold">GITHUB.COM/LEINADODREIUQZI</span>
        </a>

        <div class="contact-row">
          <span class="row-label text-muted">WORK AVAILABILITY</span>
          <span class="row-value text-magenta font-bold">ON-SITE & REMOTE AVAILABLE</span>
        </div>

        <div class="contact-row">
          <span class="row-label text-muted">PROFESSIONAL TITLE</span>
          <span class="row-value text-white font-bold">SOFTWARE ANALYST & DEVELOPER</span>
        </div>
      </div>
    </div>

    <div class="section-tag-bottom">
      <span>DIRECT CHANNELS</span>
    </div>
  </div>

  <!-- Right Tile: Big Magenta CTA Banner (Magenta Theme) -->
  <div class="grid-tile theme-magenta">
    <div class="cta-inner">
      <div class="cta-tag text-black font-bold">
        INITIATE COLLABORATION
      </div>

      <h2 class="cta-headline font-nucore text-black">
        READY TO BUILD NEXT-GEN SOFTWARE?
      </h2>

      <p class="cta-desc text-black font-mono">
        LET'S CONNECT AND DEVELOP HIGH-PERFORMANCE SOLUTIONS.
      </p>
    </div>

    <div class="section-tag-dark">
      <span>LEINAD ODREIUQZI // 2026</span>
    </div>
  </div>
</section>

<script>
  class TextScrambler {
    el: HTMLElement;
    chars: string;
    queue: Array<{ from: string; to: string; start: number; end: number; char?: string }>;
    frame: number;
    frameRequest: number;
    resolve: () => void;

    constructor(el: HTMLElement) {
      this.el = el;
      this.chars = '!<>-_\\/[]{}—=+*^?#_$%&~0123456789';
      this.queue = [];
      this.frame = 0;
      this.frameRequest = 0;
      this.resolve = () => {};
      this.update = this.update.bind(this);
    }

    setText(newText: string): Promise<void> {
      const oldText = this.el.innerText;
      const length = Math.max(oldText.length, newText.length);
      const promise = new Promise<void>((resolve) => {
        this.resolve = () => resolve();
      });
      this.queue = [];
      for (let i = 0; i < length; i++) {
        const from = oldText[i] || '';
        const to = newText[i] || '';
        const start = Math.floor(Math.random() * 10);
        const end = start + Math.floor(Math.random() * 14) + 6;
        this.queue.push({ from, to, start, end });
      }
      cancelAnimationFrame(this.frameRequest);
      this.frame = 0;
      this.update();
      return promise;
    }

    update() {
      let output = '';
      let complete = 0;
      for (let i = 0, n = this.queue.length; i < n; i++) {
        let item = this.queue[i];
        if (this.frame >= item.end) {
          complete++;
          output += item.to;
        } else if (this.frame >= item.start) {
          if (!item.char || Math.random() < 0.28) {
            item.char = this.chars[Math.floor(Math.random() * this.chars.length)];
          }
          output += item.char;
        } else {
          output += item.from;
        }
      }
      this.el.innerText = output;
      if (complete === this.queue.length) {
        this.resolve();
      } else {
        this.frameRequest = requestAnimationFrame(this.update);
        this.frame++;
      }
    }
  }

  const copyBtn = document.getElementById('copy-email-btn');
  const emailTextEl = document.getElementById('email-text');
  const copyBadge = document.getElementById('copy-badge');
  const liveAlert = document.getElementById('copy-live-alert');

  if (copyBtn && emailTextEl && copyBadge) {
    const originalEmail = 'SHERDANIALEX159357@GMAIL.COM';
    const copiedMessage = '[ COPIED TO CLIPBOARD // OK ]';
    const scrambler = new TextScrambler(emailTextEl);
    let isCopying = false;
    let resetTimer: ReturnType<typeof setTimeout> | null = null;

    copyBtn.addEventListener('click', async () => {
      if (isCopying) return;
      isCopying = true;

      try {
        await navigator.clipboard.writeText('sherdanialex159357@gmail.com');
      } catch (err) {
        // Fallback for non-https/iframe contexts
        const textarea = document.createElement('textarea');
        textarea.value = 'sherdanialex159357@gmail.com';
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }

      if (liveAlert) {
        liveAlert.textContent = 'Correo copiado al portapapeles con éxito.';
      }

      copyBtn.classList.add('is-copied');
      copyBadge.textContent = '[ OK // 200 ]';

      // Scramble into copied notification
      await scrambler.setText(copiedMessage);

      if (resetTimer) clearTimeout(resetTimer);
      resetTimer = setTimeout(async () => {
        await scrambler.setText(originalEmail);
        copyBtn.classList.remove('is-copied');
        copyBadge.textContent = '[ CLICK TO COPY ]';
        isCopying = false;
      }, 2500);
    });
  }
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 520px;
    border-bottom: 1px solid var(--border-line);
  }

  .grid-tile {
    padding: 48px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .theme-black {
    background-color: var(--bg-black);
    color: var(--text-white);
  }

  .theme-magenta {
    background-color: var(--bg-magenta);
    color: var(--text-black);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 480px;
  }

  .section-tag {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .contact-title {
    font-size: clamp(2.2rem, 3.8vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    margin-top: 4px;
  }

  .contact-sub {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 8px;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--border-line);
    text-decoration: none;
    font-size: 0.85rem;
    transition: opacity 0.15s ease;
  }

  .copy-trigger {
    background: transparent;
    border: none;
    border-bottom: 1px dashed var(--border-line);
    text-align: left;
    width: 100%;
    cursor: pointer;
    color: inherit;
    font-family: inherit;
    padding: 0 0 10px 0;
  }

  .copy-trigger:hover {
    opacity: 0.95;
  }

  .row-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .copy-badge {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    transition: color 0.15s ease;
  }

  .copy-trigger:hover .copy-badge {
    color: var(--text-magenta);
  }

  .copy-trigger.is-copied .copy-badge {
    color: var(--text-magenta) !important;
    font-weight: 700;
  }

  .copy-trigger.is-copied .row-value {
    color: var(--text-primary) !important;
  }

  .contact-row:hover {
    opacity: 0.85;
  }

  .row-label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .row-value {
    font-size: 0.95rem;
    letter-spacing: 0.03em;
  }

  .text-magenta { color: var(--text-magenta) !important; }
  .text-white { color: var(--text-white) !important; }
  .text-black { color: var(--text-black) !important; }
  .text-muted { color: var(--text-muted) !important; }
  .font-bold { font-weight: 700; }

  .section-tag-bottom {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: auto;
    padding-top: 24px;
    letter-spacing: 0.1em;
    text-align: right;
  }

  .section-tag-dark {
    font-size: 0.75rem;
    color: var(--text-black);
    margin-top: auto;
    padding-top: 24px;
    letter-spacing: 0.1em;
    text-align: right;
    font-weight: 700;
  }

  /* Right Magenta CTA */
  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 480px;
  }

  .cta-tag {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .cta-headline {
    font-size: clamp(2.2rem, 3.8vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    margin-top: 4px;
  }

  .cta-desc {
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    font-weight: 700;
  }


  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
