---

---

<section class="hero-grid">
  <!-- Left Tile: Round Visor Emblem Icon (Magenta Theme) -->
  <div class="grid-tile theme-magenta tile-left">
    <div class="visor-badge-wrapper">
      <div class="visor-icon">
        <svg
          viewBox="0 0 400 400"
          class="round-visor-svg"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label="Emblema gráfico esférico con la palabra LEINAD"
        >
          <defs>
            <!-- Strict Circle Mask for Spherical Perimeter Letter Trimming -->
            <clipPath id="badge-circle-clip">
              <circle cx="200" cy="200" r="180"></circle>
            </clipPath>

            <!-- Spherical Arc Path for Giant Distorted Base Text -->
            <path id="visor-line-3" d="M -70,222 Q 200,432 470,222"></path>

            <!-- Deep Visor Aperture Cutout Shape -->
            <clipPath id="visor-window-clip">
              <path d="M -60,-35 Q 200,115 460,-35 L 460,380 Q 200,555 -60,380 Z"></path>
            </clipPath>
          </defs>

          <!-- Outer Circular Background Badge (Clean matte black) -->
          <circle cx="200" cy="200" r="190" fill="#0D0D0E"></circle>

          <!-- Inner Content STRICTLY Clipped inside Circle Perimeter (Spherical Edge Trimming) -->
          <g clip-path="url(#badge-circle-clip)">
            <!-- Inner Uniform Matte Black Backdrop -->
            <rect x="0" y="0" width="400" height="400" fill="#0D0D0E"></rect>

            <!-- Visor Curve Cutout Zone -->
            <g clip-path="url(#visor-window-clip)">
              <!-- Visor Arch Surface -->
              <rect x="0" y="0" width="400" height="400" fill="#0D0D0E"></rect>

              <!-- Single Giant LEINAD Text (Bottom Base - 176px) -->
              <text
                font-family="var(--font-nucore)"
                font-weight="900"
                font-size="176"
                fill="#FF5500"
                letter-spacing="0.14em"
              >
                <textPath href="#visor-line-3" startOffset="50%" text-anchor="middle">
                  LEINAD
                </textPath>
              </text>
            </g>
          </g>
        </svg>
      </div>
    </div>
  </div>

  <!-- Right Tile: Full Stack Software Analyst & Developer (Black Theme) -->
  <div class="grid-tile theme-black tile-right">
    <!-- Top Metadata Block -->
    <div class="tile-meta font-mono">
      <p class="meta-desc">LEINAD ODREIUQZI — SOFTWARE ANALYST & DEVELOPER.</p>
      <p class="meta-sub text-muted">
        2.5 YEARS OF SOFTWARE ENGINEERING EXPERIENCE. SPECIALIST IN FRONTEND &
        BACKEND ARCHITECTURE.
      </p>
      <div class="meta-footer">
        <div>EXPERIENCE: 2.5 YEARS (INCL. 6-MONTH MAIN CAPSTONE)</div>
        <div>EDUCATION: SENA GRADUATE (ADSO)</div>
        <div>CAPSTONE PROJECT: LAMBDAIDX PLATFORM</div>
        <div class="text-magenta mt-2">
          AVAILABLE FOR ON-SITE & REMOTE ROLES
        </div>
      </div>
    </div>

    <!-- Giant Title: FULL STACK SOFTWARE DEVELOPER -->
    <div class="giant-headline font-nucore">
      <div class="line">FULL</div>
      <div class="line">STACK</div>
      <div class="line">SOFTWARE</div>
      <div class="line">DEVELOPER</div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 80vh;
    border-bottom: none;
  }

  .grid-tile {
    padding: 60px 48px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  /* Left Tile: Motorcycle Visor Graphic */
  .tile-left {
    background-color: var(--bg-magenta);
    color: var(--text-black);
    justify-content: center;
    align-items: center;
    padding: 48px 36px;
  }

  .visor-badge-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    gap: 20px;
  }

  .visor-icon {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .round-visor-svg {
    width: 100%;
    max-width: 360px;
    height: auto;
    max-height: 360px;
    filter: drop-shadow(0 16px 36px rgba(0, 0, 0, 0.45));
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.35s ease;
  }

  .visor-badge-wrapper:hover .round-visor-svg {
    transform: translateY(-6px) scale(1.04) rotate(3deg);
    filter: drop-shadow(0 22px 44px rgba(0, 0, 0, 0.55));
  }

  /* Right Tile: ESSENTIALLY EVERYWHERE */
  .tile-right {
    background-color: var(--bg-black);
    color: var(--text-white);
    border-left: none;
  }

  .tile-meta {
    font-size: 0.9rem;
    max-width: 480px;
    margin-bottom: 40px;
    line-height: 1.6;
  }

  .meta-desc {
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: 0.05em;
  }

  .meta-sub {
    font-size: 0.85rem;
    margin-bottom: 24px;
  }

  .meta-footer {
    font-size: 0.75rem;
    color: var(--text-muted);
    border-top: none;
    padding-top: 16px;
  }

  .mt-2 {
    margin-top: 8px;
    font-weight: 700;
  }

  .text-magenta {
    color: var(--text-magenta);
  }

  .giant-headline {
    font-size: clamp(2.5rem, 5vw, 5.5rem);
    font-weight: 700;
    color: var(--text-magenta);
    line-height: 1.35;
    letter-spacing: 0.05em;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .giant-headline .line {
    display: block;
    line-height: 1.35;
  }

  @media (max-width: 992px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .grid-tile {
      padding: 40px 24px;
    }

    .tile-left {
      padding: 40px 20px;
    }

    .round-visor-svg {
      max-width: 280px;
      max-height: 280px;
    }

    .tile-right {
      border-left: none;
      border-top: none;
    }

    .giant-headline {
      font-size: clamp(2.2rem, 8vw, 4.5rem);
      gap: 8px;
    }
  }

  @media (max-width: 480px) {
    .grid-tile {
      padding: 32px 18px;
    }

    .tile-left {
      padding: 32px 16px;
    }

    .round-visor-svg {
      max-width: 240px;
      max-height: 240px;
    }

    .giant-headline {
      font-size: clamp(1.9rem, 7.5vw, 3rem);
      gap: 6px;
    }
  }
</style>
